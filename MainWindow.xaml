<Window x:Class="LiveCue.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LiveCue — Operator" Width="1050" Height="720" Background="#151515" Foreground="White"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top"><WrapPanel Margin="0,0,0,8"><Button Content="Open TXT/RTF" Click="Open_Click" Padding="10,6"/><Button Content="Save RTF" Click="Save_Click" Padding="10,6"/><Button Content="Bold" Click="Bold_Click" Padding="10,6"/><Button Content="White" Click="White_Click" Padding="10,6"/><Button Content="Amber" Click="Amber_Click" Padding="10,6"/><Button Content="Cyan" Click="Cyan_Click" Padding="10,6"/><Button Content="Open output (F5)" Click="Live_Click" Padding="10,6"/><Button Content="Push edits" Click="SyncNow_Click" Padding="10,6"/><CheckBox x:Name="LiveSyncBox" Content="Live sync" IsChecked="True" VerticalAlignment="Center" Margin="10,0,0,0"/></WrapPanel><WrapPanel Margin="0,0,0,8"><ComboBox x:Name="ModeSelect" Width="150" SelectedIndex="0" SelectionChanged="ModeChanged"><ComboBoxItem Content="Continuous"/><ComboBoxItem Content="Manual jog"/></ComboBox><Button Content="Play/Pause" Click="Play_Click" Padding="10,6"/><Button Content="Reverse" Click="Reverse_Click" Padding="10,6"/><Button Content="Jog back" Click="JogBack_Click" Padding="10,6"/><Button Content="Jog forward" Click="JogForward_Click" Padding="10,6"/><TextBlock Text="Speed" VerticalAlignment="Center" Margin="10,0,5,0"/><Slider x:Name="SpeedSlider" Width="130" Minimum="0" Maximum="300" Value="55" ValueChanged="SpeedChanged"/><ComboBox x:Name="DisplaySelect" Width="180" Margin="10,0,0,0"/><Button Content="Fullscreen output" Click="SendDisplay_Click" Padding="10,6"/><Button Content="Floating output" Click="Floating_Click" Padding="10,6"/><Button Content="Preview" Click="Preview_Click" Padding="10,6"/></WrapPanel><TextBlock x:Name="Status" Text="Output closed" Margin="0,0,0,8" Foreground="#FFB347"/></StackPanel><RichTextBox x:Name="Editor" Background="#222222" Foreground="White" FontSize="28" AcceptsTab="True" VerticalScrollBarVisibility="Auto"/></DockPanel></Window>