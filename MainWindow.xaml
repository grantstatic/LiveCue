<Window x:Class="LiveCue.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LiveCue — Operator" Width="1440" Height="900" MinWidth="1000" MinHeight="650" Background="#111113" Foreground="#EEEEEE" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Foreground" Value="#EEEEEE"/><Setter Property="Background" Value="#29292D"/><Setter Property="BorderBrush" Value="#404047"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#FF9C32"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EEEEEE"/></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DDDDDD"/><Setter Property="Margin" Value="6"/></Style>
<Style TargetType="ComboBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="6"/></Style>
<Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="#1B1B1F"/><Setter Property="BorderBrush" Value="#303036"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12"/></Style>
</Window.Resources>
<DockPanel Margin="12">
<Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Margin="0,0,0,12"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock x:Name="Status" Foreground="#FFB347" VerticalAlignment="Center" Margin="10,0"/><Button Content="Open presenter" Click="Live_Click"/><Button Content="Floating preview" Click="Preview_Click"/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="●" Foreground="#FF9C32" FontSize="22" VerticalAlignment="Center"/><TextBlock Text="LiveCue" FontSize="24" FontWeight="SemiBold" Margin="8,0,18,0"/><TextBlock Text="OPERATOR WORKSPACE" Foreground="#999999" VerticalAlignment="Center" FontSize="11"/></StackPanel></DockPanel></Border>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230" MinWidth="180"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="340"/><ColumnDefinition Width="8"/><ColumnDefinition Width="370" MinWidth="285"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Style="{StaticResource Panel}"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Showflow" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="CURRENT SCRIPT" Foreground="#999999" Margin="0,8,0,12" FontSize="11"/><Border Background="#35271D" BorderBrush="#FF9C32" BorderThickness="1" CornerRadius="5" Padding="12"><StackPanel><TextBlock Text="01  Active script" FontWeight="SemiBold"/><TextBlock Text="Single-script workspace" Foreground="#FFB347" Margin="0,8,0,0" FontSize="11"/></StackPanel></Border><Button Content="Import script" Click="Open_Click" Margin="0,12,0,0"/><TextBlock Text="Multi-script showflow is planned." TextWrapping="Wrap" Foreground="#999999" Margin="0,12"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><TextBlock Text="KEYBOARD" Foreground="#999999" FontSize="11"/><TextBlock Text="Space  Play / pause&#x0a;Up / Down  Jog&#x0a;Left / Right  Speed&#x0a;Esc  Pause / exit fullscreen&#x0a;Ctrl+M  Switch mode&#x0a;Ctrl+R  Reverse&#x0a;Ctrl+Enter  Push edits" LineHeight="24" Margin="0,8"/></StackPanel><Grid/></DockPanel></Border>
<GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>
<Border Grid.Column="2" Style="{StaticResource Panel}"><DockPanel><StackPanel DockPanel.Dock="Top"><DockPanel Margin="0,0,0,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Import" Click="Open_Click"/><Button Content="Save project" Click="SaveProject_Click"/><Button Content="Save RTF" Click="Save_Click"/></StackPanel><TextBlock Text="Script editor" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><WrapPanel Margin="0,0,0,8"><Button Content="B" FontWeight="Bold" Click="Bold_Click"/><Button Content="White" Click="White_Click"/><Button Content="Amber" Foreground="#FFB347" Click="Amber_Click"/><Button Content="Cyan" Foreground="#5AC8E8" Click="Cyan_Click"/><CheckBox x:Name="LiveSyncBox" Content="Auto push edits" IsChecked="False" VerticalAlignment="Center"/></WrapPanel></StackPanel><Button DockPanel.Dock="Bottom" Content="Push to live output" Background="#FF9C32" Foreground="#111113" FontWeight="SemiBold" Click="SyncNow_Click" Margin="0,12,0,0"/><RichTextBox x:Name="Editor" Background="#101012" Foreground="White" BorderBrush="#303036" Padding="18" FontSize="24" AcceptsTab="True" VerticalScrollBarVisibility="Auto"/></DockPanel></Border>
<GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>
<Border Grid.Column="4" Style="{StaticResource Panel}"><DockPanel>
<StackPanel DockPanel.Dock="Top"><TextBlock Text="Live preview" FontSize="19" FontWeight="SemiBold"/><Border Focusable="True" MouseLeftButtonDown="PreviewFocus_Click" Background="Black" BorderBrush="#303036" BorderThickness="1" CornerRadius="5" Margin="0,10,0,8" Height="190" ClipToBounds="True"><Grid><Viewbox x:Name="StandbyHost" Stretch="Uniform"/><Rectangle x:Name="EmbeddedMirror" Visibility="Collapsed" IsHitTestVisible="False"/></Grid></Border><UniformGrid Columns="3"><Button Content="Play / pause" Click="Play_Click" Background="#FF9C32" Foreground="#111113"/><Button Content="Pause" Click="Pause_Click"/><Button Content="Reverse" Click="Reverse_Click"/><Button Content="Jog back" Click="JogBack_Click"/><Button Content="Jog forward" Click="JogForward_Click"/></UniformGrid><TextBlock Text="SCROLL SPEED" Foreground="#999999" FontSize="11" Margin="0,7,0,3"/><Slider x:Name="SpeedSlider" Minimum="0" Maximum="300" Value="55" ValueChanged="SpeedChanged"/><ComboBox x:Name="ModeSelect" SelectedIndex="0" SelectionChanged="ModeChanged"><ComboBoxItem Content="Continuous"/><ComboBoxItem Content="Manual jog"/></ComboBox></StackPanel>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<Border Height="1" Background="#404047" Margin="0,8"/>
<TextBlock Text="Display settings" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Changes apply live" Foreground="#FFB347" FontSize="11" Margin="0,3,0,8"/>
<StackPanel x:Name="AppearanceControls">
<TextBlock Text="FONT FAMILY" Foreground="#999999" FontSize="11"/><ComboBox x:Name="FontChoice" SelectionChanged="AppearanceChanged"/><TextBlock x:Name="FontNotice" Foreground="#FFB347" TextWrapping="Wrap" FontSize="11"/>
<TextBlock Text="FONT SIZE (PT)" Foreground="#999999" FontSize="11" Margin="0,5,0,4"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><Slider x:Name="SizeSlider" Minimum="12" Maximum="160" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,8,0" ValueChanged="SizeChanged"/><TextBox x:Name="SizeField" Grid.Column="1" Padding="5" TextChanged="SizeTyped" ToolTip="12–160 points"/></Grid>
<TextBlock Text="WEIGHT / LETTER CASE" Foreground="#999999" FontSize="11" Margin="0,9,0,3"/><UniformGrid Columns="2"><ComboBox x:Name="WeightChoice" SelectionChanged="AppearanceChanged"><ComboBoxItem Content="As scripted"/><ComboBoxItem Content="Regular"/><ComboBoxItem Content="Bold"/></ComboBox><ComboBox x:Name="CaseChoice" SelectionChanged="AppearanceChanged"><ComboBoxItem Content="Original case"/><ComboBoxItem Content="ALL CAPS"/></ComboBox></UniformGrid>
<TextBlock Text="TEXT COLOUR" Foreground="#999999" FontSize="11" Margin="0,5,0,3"/><DockPanel><Button DockPanel.Dock="Right" Content="Choose…" Click="ChooseColor"/><Border x:Name="ColorSwatch" Width="22" Background="White" Margin="0,5,6,5"/><TextBox x:Name="ColorField" Margin="0,3" Padding="5" TextChanged="ColorChanged" ToolTip="#RRGGBB"/></DockPanel><CheckBox x:Name="Preserve" Content="Preserve coloured cues" Checked="AppearanceChanged" Unchecked="AppearanceChanged"/><TextBlock x:Name="AppearanceError" Foreground="#FFB347" TextWrapping="Wrap" FontSize="11"/><Button Content="Reset display settings" Click="ResetAppearance"/>
</StackPanel>
<Border Height="1" Background="#404047" Margin="0,10"/><TextBlock Text="PRESENTER OUTPUT" Foreground="#999999" FontSize="11"/><ComboBox x:Name="DisplaySelect"/><UniformGrid Columns="2"><Button Content="Fullscreen output" Click="SendDisplay_Click"/><Button Content="Floating output" Click="Floating_Click"/></UniformGrid><Button Content="Open floating preview" Click="Preview_Click"/>
</StackPanel></ScrollViewer></DockPanel></Border>
</Grid></DockPanel></Window>