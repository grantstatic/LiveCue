<Window x:Class="LiveCue.AppearanceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LiveCue — Display settings" Width="550" SizeToContent="Height" MaxHeight="740" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#19191D" Foreground="#EEEEEE" FontFamily="Segoe UI"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Text="Presenter display settings" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Applies to presenter and both previews, not the editor." Foreground="#AAAAAA" Margin="0,6,0,18" TextWrapping="Wrap"/><TextBlock Text="FONT FAMILY" Foreground="#AAAAAA" FontSize="11"/><ComboBox x:Name="FontChoice" Margin="0,6,0,4" Padding="8" SelectionChanged="Changed"/><TextBlock x:Name="FontNotice" Foreground="#FFB347" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock Text="GLOBAL FONT SIZE (POINTS)" Foreground="#AAAAAA" FontSize="11"/><Grid Margin="0,6,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions><Slider x:Name="SizeSlider" Minimum="12" Maximum="160" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SizeChanged" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBox x:Name="SizeField" Grid.Column="1" Padding="7" TextChanged="SizeTyped" ToolTip="12–160 points"/></Grid><TextBlock Text="FONT WEIGHT" Foreground="#AAAAAA" FontSize="11"/><ComboBox x:Name="WeightChoice" Margin="0,6,0,14" Padding="8" SelectionChanged="Changed"><ComboBoxItem Content="As scripted"/><ComboBoxItem Content="Regular"/><ComboBoxItem Content="Bold"/></ComboBox><TextBlock Text="TEXT COLOUR" Foreground="#AAAAAA" FontSize="11"/><DockPanel Margin="0,6,0,8"><Button DockPanel.Dock="Right" Content="Choose colour…" Click="ChooseColor" Padding="12,6"/><TextBox x:Name="ColorField" Padding="7" TextChanged="ColorChanged" ToolTip="#RRGGBB"/></DockPanel><CheckBox x:Name="Preserve" Foreground="#EEEEEE" Content="Preserve individually coloured stage directions" Checked="Changed" Unchecked="Changed" Margin="0,0,0,16"/><Border Background="Black" CornerRadius="6" Padding="14" Height="146" ClipToBounds="True"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="Sample" Text="Good evening everyone." TextWrapping="Wrap" TextAlignment="Center"/><TextBlock x:Name="Cue" Text="[PAUSE FOR APPLAUSE]" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border><TextBlock Text="Sample is scaled to fit this window." Foreground="#999999" FontSize="11" Margin="0,5,0,14"/><TextBlock x:Name="ErrorText" Foreground="#FFB347" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Reset" Click="Reset" Padding="12,8" Margin="4"/><Button Content="Cancel" IsCancel="True" Padding="12,8" Margin="4"/><Button Content="Apply to output" IsDefault="True" Click="Apply" Background="#FF9C32" Foreground="#111111" Padding="16,8" Margin="4"/></StackPanel></StackPanel></ScrollViewer></Window>